# Media is never committed: only the logic lives in git.
# Patterns apply at any depth, so they cover every videos/<name>/ folder.

# Rendered / generated / third-party media
*.mp4
*.mp3
*.wav
*.m4a
*.png
*.jpg

# Per-video generated folders (videos/<name>/audio, videos/<name>/build)
audio/
build/

# Shared music library at the repo root (download tracks locally; see README)
/music/

# Environments
node_modules/
.venv/
__pycache__/

# OS / editor
.DS_Store
.vscode/
.idea/
